# ── Environment variables ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Backend reads these at startup via os.getenv().

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default — no change needed for local dev)
DATABASE_URL=sqlite:///./database/har_predictions.db

# ── Model ──────────────────────────────────────────────────────────────────────
# Directory containing har_model.keras and scaler artefacts
MODEL_PATH=./saved_models

# ── Backend ────────────────────────────────────────────────────────────────────
# Port for uvicorn (Render sets this automatically)
PORT=8000

# CORS — comma-separated list of allowed origins
# Set to your Streamlit Cloud URL in production
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ── Frontend ───────────────────────────────────────────────────────────────────
# Full URL of the FastAPI backend (used by Streamlit)
# For Streamlit Cloud: set this to your Render deployment URL
API_URL=http://localhost:8000
